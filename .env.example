# Copy this file to .env and fill in real values before running.

PORT=4000

# Long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

DB_PATH=./data.json
UPLOAD_DIR=./uploads

# The published Life Documents page. Used in password-reset emails.
# Include https:// and no trailing slash.
FRONTEND_URL=https://claude.ai/artifact/G4rjxzdF57WyN2Dhpy11Ko

# The email address of YOUR account (sign up with this one). Only this
# account can see the admin dashboard with everyone's data — every other
# user only ever sees their own documents.
ADMIN_EMAIL=you@example.com

# --- Email (used for password-reset links AND the daily expiry-reminder emails) ---
# Any SMTP account works. Easiest options:
#  - Gmail: smtp.gmail.com, port 465, an "app password" (not your normal password)
#  - SendGrid / Mailgun / Postmark: use their SMTP relay credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Life Documents <you@example.com>"
